# Required for live T3N (claim at https://go.terminal3.io/adk-community)
T3N_API_KEY=

# Force offline stub even if T3N_API_KEY is set (default: auto)
# TRUSTDESK_MODE=stub|live
TRUSTDESK_MODE=stub

# Optional LLM polish for ticket summary (stub used if unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
